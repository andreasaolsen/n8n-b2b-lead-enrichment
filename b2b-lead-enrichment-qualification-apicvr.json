    {
      "parameters": {
        "jsCode": "// Find alle unikke industrikoder markeret som target = TRUE\nconst targetCodes = new Set(\n  $input.all()\n    .filter(item => String(item.json.target ?? '').trim().toUpperCase() === 'TRUE')\n    .map(item => String(item.json.industry_code ?? '').trim())\n);\n\n// Hent alle enrichede leads (ikke bare det aktuelle item)\nconst leads = $('Enrich & Qualify').all();\n\nreturn leads.map(item => {\n  const lead = item.json;\n  const code = String(lead.industry_code ?? '').trim();\n\n  return {\n    json: {\n      ...lead,\n      industry_match: targetCodes.has(code)\n    }\n  };\n});"
      },
