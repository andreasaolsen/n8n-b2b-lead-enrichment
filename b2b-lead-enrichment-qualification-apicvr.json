      "id": "51aa1c51-e166-44fb-b73d-5abb48139977",
      "name": "APICVR",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        2928,
        528
      ]
    },
    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const lead = $('Only Unprocessed').item.json;\nconst api = $json;\n\nconst enddate = api.enddate ?? null;\nconst employees = api.employees;\nconst protectedFlag = api.protected === true;\nconst bankrupt = api.bankrupt === true;\n\nlet priority;\nif (enddate) {\n  priority = 'Inactive – Do Not Contact';\n} else if (bankrupt) {\n  priority = 'Do Not Contact';\n} else if (protectedFlag) {\n  priority = 'Do Not Contact';\n} else if (typeof employees === 'number') {\n  if (employees >= 50) priority = 'High';\n  else if (employees >= 10) priority = 'Medium';\n  else priority = 'Low';\n} else {\n  priority = 'Unknown';\n}\n\nreturn {\n  json: {\n    lead_name: lead.lead_name ?? '',\n    lead_email: lead.lead_email ?? '',\n    cvr: String(api.vat ?? lead.cvr ?? ''),\n    company_name: api.name ?? '',\n    company_status: api.status ?? '',\n    company_type: api.companytypeshort ?? api.companydesc ?? '',\n    company_status_date: enddate ?? '',\n    bankrupt,\n    protected: protectedFlag,\n    industry_code: String(api.industrycode ?? ''),\n    industry_description: api.industrydesc ?? '',\n    employees: employees ?? '',\n    establishment_date: api.startdate ?? '',\n    address: api.address ?? '',\n    postal_code: api.zipcode ?? '',\n    city: api.city ?? '',\n    priority,\n    data_source: 'apicvr.dk',\n    processed_at: new Date().toISOString()\n  }\n};"
      },
